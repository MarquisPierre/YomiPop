{
  "name": "yomipop",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/extension",
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web,ext -c blue,magenta,yellow \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w apps/extension\"",
    "lint": "eslint . && npm run lint -w apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/extension",
    "build:dict": "tsx scripts/build-dictionary.ts",
    "icons": "tsx scripts/make-icons.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@scriptin/jmdict-simplified-types": "^3.6.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
