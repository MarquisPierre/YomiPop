generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Stores one flashcard and where it is in the review schedule.
model Card {
  id        String   @id @default(cuid())
  word      String
  reading   String
  meanings  String[]
  entryId   String?  @unique
  createdAt DateTime @default(now())

  dueAt          DateTime  @default(now())
  lastReviewAt   DateTime?
  stability      Float     @default(0)
  stabilityFast  Float     @default(0)
  difficulty     Float     @default(0)
  scheduledDays  Float     @default(0)
  learningStep   Int       @default(0)
  reps           Int       @default(0)
  lapses         Int       @default(0)
  state          Int       @default(0)
  scheduleStatus String    @default("new")

  reviews Review[]
}

// Records one answer given during a review.
model Review {
  id         String   @id @default(cuid())
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId     String
  rating     Int
  reviewedAt DateTime @default(now())
}
