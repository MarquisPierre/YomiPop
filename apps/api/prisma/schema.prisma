generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Stores one flashcard and where it is in the review schedule.
model Card {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  // Puts the card in a deck. Deleting the deck deletes its cards.
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId      String
  word        String
  reading     String
  meanings    String[]
  entryId     String?
  sentence    String?
  translation String?
  // Points to the card's picture, if it has one. Deleting the picture just leaves the card without one.
  image       Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId     String?
  createdAt   DateTime @default(now())

  dueAt          DateTime  @default(now())
  lastReviewAt   DateTime?
  stability      Float     @default(0)
  stabilityFast  Float     @default(0)
  difficulty     Float     @default(0)
  scheduledDays  Float     @default(0)
  learningStep   Int       @default(0)
  reps           Int       @default(0)
  lapses         Int       @default(0)
  state          Int       @default(0)
  scheduleStatus String    @default("new")

  reviews Review[]

  @@unique([userId, entryId])
  @@index([userId, dueAt])
  @@index([deckId])
}

// Records one answer given during a review.
model Review {
  id            String   @id @default(cuid())
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId        String
  rating        Int
  reviewedAt    DateTime @default(now())
  // The card's schedule before this answer, so the answer can be undone.
  previousState Json?
}

// Stores a group of cards the user reviews together, like a deck in Anki.
model Deck {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  createdAt DateTime @default(now())
  cards     Card[]

  // Keeps deck names unique for each user.
  @@unique([userId, name])
}

// Stores a picture used on cards, where it came from, and the credit its license asks for.
model Media {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  url         String
  // Says where the picture came from: "search" for now; "generated" or "uploaded" could come later.
  source      String
  // Holds the credit line, e.g. "Photo by Jane Doe on Pexels".
  attribution String?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
  cards       Card[]
}

// Records each AI or image request, for the daily limit per user.
model AiUsage {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // Says which kind of request it was: "sentences" or "image".
  type      String
  createdAt DateTime @default(now())

  // Makes counting a user's requests today fast.
  @@index([userId, createdAt])
}

// Keeps AI and image results by word, so common words like 食べる are looked up once for everyone.
model AiCache {
  // Combines the kind of request with the word and meaning, e.g. "sentences|食べる|to eat".
  key       String   @id
  result    Json
  createdAt DateTime @default(now())
}

// Stores an account. The tables below are generated by Better Auth.
model User {
  id             String    @id
  name           String
  email          String
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Caps how many brand-new cards the review brings in each day.
  newCardsPerDay Int       @default(20)
  sessions       Session[]
  accounts       Account[]
  cards          Card[]
  decks          Deck[]
  media          Media[]
  aiUsage        AiUsage[]

  @@unique([email])
  @@map("user")
}

// Stores one place a user is logged in.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// Stores how a user logs in, including their hashed password.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Stores short-lived codes, like email verification links.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
