{
  "manifest_version": 3,
  "name": "YomiPop",
  "version": "1.0.0",
  "description": "Hover Japanese words for instant readings and meanings, then save them as flashcards with AI sentences, pictures and audio.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/menu/menu.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage", "scripting", "cookies", "alarms"],
  "host_permissions": ["http://localhost/*", "https://yomipop.vercel.app/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"]
    }
  ]
}
