# Dependencies (rebuilt by npm install)
node_modules/

# Build output
dist/
dist-prod/
.next/
out/
*.tsbuildinfo
apps/api/src/generated/

# Secrets — never commit these
.env
.env.*
!.env.example
# The extension's live address isn't secret, so it's committed.
!apps/extension/.env.production

# Generated dictionary data (build-dictionary.ts recreates it)
apps/extension/public/dict/
data/

# Test output
coverage/
playwright-report/
test-results/

# Logs and OS/editor junk
*.log
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
