{
  "name": "yomipop",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "yomipop",
      "workspaces": [
        "packages/shared",
        "apps/api",
        "apps/extension"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@yomipop/api",
      "version": "0.0.0"
    },
    "apps/extension": {
      "name": "@yomipop/extension",
      "version": "0.0.0"
    },
    "node_modules/@yomipop/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@yomipop/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@yomipop/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@yomipop/shared",
      "version": "0.0.0"
    }
  }
}
